# email-service environment variables. Names only, never values.
# Secrets are set as Cloudflare Worker secrets.

# Shared secret for the X-Email-Secret header on POST /send.
EMAIL_SECRET=
# Comma-separated sender addresses callers may use (per-form senders).
ALLOWED_SENDERS=
# Sender used when the caller omits `from`.
DEFAULT_FROM=
# Dev-only redirect for every recipient.
TEST_EMAIL=
